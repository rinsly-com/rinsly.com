# Payload secret — used to sign auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# The D1 database and R2 bucket are provided by Cloudflare Worker bindings
# configured in wrangler.jsonc — there is no DATABASE_URL here.

# Canonical public origin. Used for metadataBase, canonical URLs, sitemap,
# hreflang and (in production) Cloudflare Image Transformations.
# Local dev: http://localhost:3000. Production: https://rinsly.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra browser origins allowed to call the API (comma-separated).
# FRONTEND_URL=https://rinsly.com

# Optional: log level for the production (Workers) logger — trace|debug|info|warn|error
# PAYLOAD_LOG_LEVEL=info
