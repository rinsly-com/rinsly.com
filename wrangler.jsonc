{
  // ===========================================================================
  // ACCP — the dynamic Cloudflare Worker serving the Payload admin + API + the
  // localized Next.js frontend (SSR), backed by D1 (database) and R2 (media),
  // at accp.rinsly.com. The PUBLIC site (rinsly.com) is a separate static export
  // built from this worker's published content — see wrangler.static.jsonc.
  //
  // Local `pnpm dev` uses a local SQLite mock via wrangler's platform proxy;
  // remote bindings are only enabled in production builds (see
  // getCloudflareContextFromWrangler in payload.config.ts).
  //
  // Cloudflare resources (created 2026-07-23):
  //   D1 "rinsly-accp" (07896317-…) + R2 "rinsly-accp" — bound below.
  // Remaining before the CMS is fully usable:
  //   - Set the runtime PAYLOAD_SECRET (+ DEPLOY_DISPATCH_TOKEN) on this worker.
  //   - Attach the accp.rinsly.com custom domain to this worker in the
  //      Cloudflare dashboard (Worker → Settings → Domains & Routes). NOT via
  //      wrangler routes: CI deploys with an account-scoped token that can't
  //      manage zone (Workers Routes) permissions.
  // ===========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rinsly-accp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js APIs in the Worker runtime.
    "nodejs_compat",
    // Allow the app to fetch public URLs.
    "global_fetch_strictly_public",
  ],
  // Custom domain (accp.rinsly.com) is attached in the Cloudflare dashboard, NOT
  // here — so CI's account-scoped token doesn't need zone (Workers Routes) perms.
  // wrangler deploy only updates the worker script; the domain binding persists.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "rinsly-accp",
      "database_id": "07896317-ed2b-41d6-8b72-8ddce580690a",
      "remote": true,
    },
  ],
  // Media originals stored in R2, served by this worker at /api/media/file/<f>.
  // payload.config.ts activates the R2 storage adapter once this binding exists.
  // Production rewrites these URLs through Cloudflare Image Transformations
  // (/cdn-cgi/image) — enable it on the rinsly.com zone. See src/lib/image.ts.
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "rinsly-accp" },
    // LeadLens scorecards for the personal /check/<token> pages. LeadLens (the
    // sales tool) writes `<token>/scorecard.json` + `<token>/desktop.png` +
    // `<token>/mobile.png`; this worker only reads. Create the bucket once:
    //   wrangler r2 bucket create leadlens-checks
    // The PUBLIC URL (rinsly.com/check/<token>) needs a zone route to THIS
    // worker — the static rinsly.com worker has no runtime. In the dashboard,
    // add route `rinsly.com/check/*` -> rinsly-accp (same dashboard-not-CI
    // reasoning as the custom domain above). Until then, LeadLens can link to
    // accp.rinsly.com/check/<token>.
    { "binding": "LEADLENS_CHECKS", "bucket_name": "leadlens-checks" },
  ],
  // Self-service /check runs enrich with Google PageSpeed Insights when the
  // PSI_API_KEY Worker SECRET is set (free key via Google Cloud console;
  // keyless calls are 429'd). Without it the check degrades to probe-based
  // speed heuristics: wrangler secret put PSI_API_KEY
  //
  // Rate limit: 5 scans per IP per day. Logged-in admin users are exempt, and
  // so are IPs in the CHECK_RATE_EXEMPT_IPS secret (comma-separated), e.g.
  // your own: wrangler secret put CHECK_RATE_EXEMPT_IPS
  // Locally: put both in .dev.vars (read by the dev platform proxy).
  "vars": {
    // GitHub repository_dispatch endpoint the CMS "Deploy" button POSTs to (see
    // src/hooks/triggerStaticDeploy.ts). Non-secret. The paired
    // DEPLOY_DISPATCH_TOKEN is a Worker SECRET (never stored here).
    "DEPLOY_DISPATCH_URL": "https://api.github.com/repos/rinsly-com/rinsly.com/dispatches",
  },
}
